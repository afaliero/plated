# Copy to apps/api/.env and fill in.
# NEVER commit the real .env — and never put this key in the Expo app.

# https://spoonacular.com/food-api/console#Dashboard
SPOONACULAR_API_KEY=your_key_here

PORT=3000

# Seconds. Spoonacular's terms cap caching of their data at 1 hour (3600s).
# Do not raise this above 3600 without re-reading their ToS.
CACHE_TTL_SECONDS=900

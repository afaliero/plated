# Copy to apps/backend/.env and fill in.
# NEVER commit the real .env — and never put this key in the Expo app.

# https://spoonacular.com/food-api/console#Dashboard
SPOONACULAR_API_KEY=your_key_here

PORT=3000

# MySQL connection used by the backend.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=plated
MYSQL_USER=plated
MYSQL_PASSWORD=replace_with_local_database_password
# Used only by Docker to initialize MySQL; the backend uses MYSQL_USER above.
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

# Seconds. Spoonacular's terms cap caching of their data at 1 hour (3600s).
# Do not raise this above 3600 without re-reading their ToS.
SPOONACULAR_CACHE_TTL_SECONDS=900

# Optional: required only when a user enters a craving preference.
# Never commit a real key or put this in the Expo app.
OPENAI_API_KEY=your_openai_key_here
